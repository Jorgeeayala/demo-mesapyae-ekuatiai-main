{
  "manifest_version": 3,
  "name": "Mesa Pya'e · Migrador e-Kuatia'i",
  "short_name": "Migrador e-Kuatia'i",
  "version": "1.0.5",
  "description": "Pasa los datos de factura de un cobro de Mesa Pya'e al formulario de e-Kuatia'i (DNIT). La firma con PIN y la emisión siempre las hace una persona.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://ekuatia.set.gov.py/*",
    "https://desa-ekuatia.set.gov.py/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://ekuatia.set.gov.py/*", "https://desa-ekuatia.set.gov.py/*"],
      "js": ["campos.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://mesapyae-pruebas.netlify.app/*",
      "https://mesapyae-demo.web.app/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "action": {
    "default_title": "Migrador e-Kuatia'i",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
